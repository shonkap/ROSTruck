<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>truck_sim</name>
  <version>0.1.0</version>
  <description>
    Simulation of the Redcat Ground Pounder: Gazebo Harmonic physics and stereo
    cameras, driven by ArduPilot SITL Rover through the ardupilot_gazebo plugin,
    with fc_bridge and RTAB-Map exactly as on the truck. Workstation only
    (docker/sitl.Dockerfile); not built on the Jetson.
  </description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>fc_bridge</exec_depend>
  <exec_depend>truck_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
