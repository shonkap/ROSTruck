Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: map
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Occupancy map (/map)
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D map (/cloud_map)
      Enabled: true
      Topic:
        Value: /cloud_map
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/Odometry
      Name: Visual odometry (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
      Keep: 200
      Shape:
        Value: Arrow
        Shaft Length: 0.15
        Head Length: 0.05
        Shaft Radius: 0.01
        Head Radius: 0.03
        Color: 255; 25; 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Topic:
        Value: /stereo/left/image_raw
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
      Target Frame: map
Window Geometry:
  Width: 1100
  Height: 850
  X: 480
  Y: 40
