    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <!-- model: x forward, y left, z up -> ArduPilot body FRD -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>

      <!-- SERVO1 front steering -> front_left -->
      <control channel="0">
        <jointName>front_left_steer</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/ground_pounder/front_left_steer/cmd</cmd_topic>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>-1</multiplier>
      </control>
      <!-- SERVO1 front steering -> front_right -->
      <control channel="0">
        <jointName>front_right_steer</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/ground_pounder/front_right_steer/cmd</cmd_topic>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>-1</multiplier>
      </control>
      <!-- SERVO2 rear steering (reversed on the FC) -> rear_left -->
      <control channel="1">
        <jointName>rear_left_steer</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/ground_pounder/rear_left_steer/cmd</cmd_topic>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>-1</multiplier>
      </control>
      <!-- SERVO2 rear steering (reversed on the FC) -> rear_right -->
      <control channel="1">
        <jointName>rear_right_steer</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/ground_pounder/rear_right_steer/cmd</cmd_topic>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>-1</multiplier>
      </control>
      <!-- SERVO3 throttle -> front_left wheel -->
      <control channel="2">
        <jointName>front_left_spin</jointName>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>133.4</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <p_gain>0.05</p_gain><i_gain>0</i_gain><d_gain>0.0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.35</cmd_max><cmd_min>-0.35</cmd_min>
      </control>
      <!-- SERVO3 throttle -> front_right wheel -->
      <control channel="2">
        <jointName>front_right_spin</jointName>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>133.4</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <p_gain>0.05</p_gain><i_gain>0</i_gain><d_gain>0.0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.35</cmd_max><cmd_min>-0.35</cmd_min>
      </control>
      <!-- SERVO3 throttle -> rear_left wheel -->
      <control channel="2">
        <jointName>rear_left_spin</jointName>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>133.4</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <p_gain>0.05</p_gain><i_gain>0</i_gain><d_gain>0.0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.35</cmd_max><cmd_min>-0.35</cmd_min>
      </control>
      <!-- SERVO3 throttle -> rear_right wheel -->
      <control channel="2">
        <jointName>rear_right_spin</jointName>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <offset>-0.5</offset>
        <multiplier>133.4</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <p_gain>0.05</p_gain><i_gain>0</i_gain><d_gain>0.0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.35</cmd_max><cmd_min>-0.35</cmd_min>
      </control>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steer</joint_name>
      <topic>/model/ground_pounder/front_left_steer/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>6</cmd_max>
      <cmd_min>-6</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steer</joint_name>
      <topic>/model/ground_pounder/front_right_steer/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>6</cmd_max>
      <cmd_min>-6</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>rear_left_steer</joint_name>
      <topic>/model/ground_pounder/rear_left_steer/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>6</cmd_max>
      <cmd_min>-6</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>rear_right_steer</joint_name>
      <topic>/model/ground_pounder/rear_right_steer/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>6</cmd_max>
      <cmd_min>-6</cmd_min>
    </plugin>

    <!-- Ground truth pose, ONLY for grading SLAM in sim (the truck has no such thing). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>ground_pounder</robot_base_frame>
      <odom_topic>/model/ground_pounder/odometry</odom_topic>
      <tf_topic>/model/ground_pounder/odometry_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
