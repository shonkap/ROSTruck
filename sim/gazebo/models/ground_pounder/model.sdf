<sdf version="1.9">
  <model name="ground_pounder">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <pose>0 0 0.132 0 0 0</pose>
      <inertial>
        <mass>2.2</mass>
        <inertia><ixx>0.00850667</ixx><iyy>0.0335133</iyy><izz>0.0396733</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.42 0.2 0.08</size></box></geometry>
      </collision>
      <visual name="body">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.441 0.305 0.07</size></box></geometry>
