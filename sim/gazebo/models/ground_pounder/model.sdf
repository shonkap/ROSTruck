      </visual>
      <visual name="camera_bar">
        <pose>0.16 0 0.09 0 0 0</pose>
        <geometry><box><size>0.03 0.16 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <sensor name="left_camera" type="camera">
        <pose>0.16 0.05 0.09 0 0.1 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>stereo/left/image</topic>
        <camera name="left">
          <camera_info_topic>stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.004</stddev></noise>
        </camera>
      </sensor>
      <sensor name="right_camera" type="camera">
        <pose>0.16 -0.05 0.09 0 0.1 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>stereo/right/image</topic>
        <camera name="right">
          <camera_info_topic>stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.004</stddev></noise>
        </camera>
      </sensor>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0.12 0 0.128 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>5.5</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
      <visual name="lidar_puck">
        <pose>0.12 0 0.10300000000000001 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="imu_link">
      <pose>0 0 0.132 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-05</ixx><iyy>1e-05</iyy><izz>1e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- Rolled 180 deg so the sensor measures in ArduPilot's FRD body frame
           (ArduPilotPlugin forwards IMU data as-is; same as ardupilot_gazebo's iris). -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="front_left_knuckle">
      <pose>0.16 0.125 0.062 0 0 0</pose>
