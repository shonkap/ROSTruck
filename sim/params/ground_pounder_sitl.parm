# SITL parameters for the Ground Pounder in Gazebo (loaded on top of
# ArduPilot's Tools/autotest/default_params/rover.parm).
#
# Output mapping is IDENTICAL to the real FC (see fc_real_*.parm, pulled with
# scripts/fc_check.py --save-params): front + rear GroundSteering, rear
# reversed, throttle on SERVO3. The Gazebo model just receives those PWMs.

FRAME_CLASS 1
# Real EKF3 like the FC (SITL defaults to 10 = perfect "cheat" AHRS).
AHRS_EKF_TYPE 3
EK3_ENABLE 1
EK2_ENABLE 0
SERVO1_FUNCTION 26
SERVO2_FUNCTION 26
SERVO2_REVERSED 1
SERVO3_FUNCTION 70
SERVO1_MIN 1000
SERVO1_TRIM 1500
SERVO1_MAX 2000
SERVO2_MIN 1000
SERVO2_TRIM 1500
SERVO2_MAX 2000
SERVO3_MIN 1000
SERVO3_TRIM 1500
SERVO3_MAX 2000
# brushed/bidirectional ESC style: 1500 = stop, <1500 reverse (like the real ESC)
MOT_PWM_TYPE 0

# Same speed scaling as the real FC, so cmd_vel means the same in sim and on the truck.
WP_SPEED 2
CRUISE_SPEED 2
CRUISE_THROTTLE 50
ATC_STR_RAT_MAX 120
# Tuned with `ros2 run truck_sim turn_test` (FF 0.3 only reached ~35% of the
# requested turn rate with this wheelbase / 0.5 rad steering limit).
ATC_STR_RAT_FF 0.9
ATC_STR_RAT_P 0.2
ATC_STR_RAT_I 0.2
ATC_SPEED_P 0.3
ATC_SPEED_I 0.2
ATC_ACCEL_MAX 2
ATC_DECEL_MAX 3
TURN_RADIUS 0.3

# ---- Recommended for the REAL truck too (it currently has ARMING_REQUIRE 0
# ---- and all six modes = MANUAL). 3-position switch on channel 8:
#      low = MANUAL, middle = HOLD, high = GUIDED (Jetson drives).
ARMING_REQUIRE 1
MODE_CH 8
MODE1 0
MODE2 0
MODE3 4
MODE4 4
MODE5 15
MODE6 15
INITIAL_MODE 4

# SITL has no transmitter: don't trip the RC/throttle failsafe.
FS_THR_ENABLE 0
# Indoors-in-sim: SITL still simulates GPS so GUIDED works out of the box.
# The real truck has no GPS fix indoors, see README "GUIDED indoors".
