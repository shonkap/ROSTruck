# What the truck runs at power-up (scripts/truck.sh start, and the autostart
# service). Arguments for truck.launch.py - see its header and the README.
#   lidar:=true            RPLidar A1 on /dev/rplidar (+ lidar guard, fused SLAM)
#   slam:=true             RTAB-Map on the Jetson (else run SLAM on the PC)
#   map_name:=house localization:=true   drive in a saved map instead of mapping
#   detector:=true         object detector plugin
#   fc:=none               no flight controller (bench testing)
# After editing: ./scripts/truck.sh restart
TRUCK_LAUNCH_ARGS=lidar:=true
