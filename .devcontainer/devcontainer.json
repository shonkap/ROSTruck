{
  "name": "RCTruckAuto Dev (ROS2 Humble, x86)",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "fake_fc"],
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "shutdownAction": "stopCompose",

  // Workstation dev container (code, build, test against sim/fake_fc.py or
  // the real FC via scripts/fc_udp_forward.py). The Jetson uses a separate
  // arm64 image: docker/jetson.Dockerfile + docker/docker-compose.jetson.yml.

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-iot.vscode-ros",
        "anthropic.claude-code"
      ],
      "settings": {
        "ROS2.distro": "humble",
        "python.analysis.extraPaths": [
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/humble/local/lib/python3.10/dist-packages"
        ]
      }
    }
  },

  // `ros2 --version` (the old command here) isn't a valid ros2 CLI call and
  // made container creation fail. Build the workspace instead.
  "postCreateCommand": "bash -c 'source /opt/ros/humble/setup.bash && cd /workspace/ros2_ws && colcon build --symlink-install'"
}
